    <PackageReference Include="Radzen.Blazor" Version="5.7.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Rebecca.BeWell.BlazorApp.Shared\Rebecca.BeWell.BlazorApp.Shared.csproj" />
  </ItemGroup>
